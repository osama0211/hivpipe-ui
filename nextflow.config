/*
 * Each pipeline runs in its own container. They have incompatible dependency
 * trees — shiver needs IVA and smalt, viral-ngs needs Trinity and a JVM,
 * V-pipe drives its own conda environments — so one image holding all five
 * would be fragile and enormous. Nextflow starts the right one per process.
 */

manifest {
    name            = 'hivpipe'
    description     = 'HIV-1 consensus assembly with a structural check on the output'
    mainScript      = 'main.nf'
    nextflowVersion = '>=23.10.0'  // tested on 24.10.4 and 26.10.0
    version         = '1.0.0'
}

params {
    outdir     = 'results'
    publish    = 'copy'
    tracedir   = "${params.outdir}/_trace"

    // Override any of these to pin a different build.
    containers {
        app          = 'hivpipe/app:1.0.0'
        shiver       = 'ghcr.io/hcovlab/dshiver:latest'
        vpipe        = 'ghcr.io/cbg-ethz/v-pipe:master'
        smaltalign   = 'hivpipe/smaltalign:1.0.0'
        viralngs     = 'quay.io/broadinstitute/viral-assemble:2.4.1.0'
        hivgenopipe  = 'hivpipe/hivgenopipe:1.0.0'
    }

    smaltalign_iterations = 4

}

process {
    errorStrategy = 'terminate'
    cache         = 'lenient'

    withLabel: light {
        cpus   = 1
        memory = 2.GB
        time   = 30.m
    }
    withLabel: assembly {
        cpus   = 8
        memory = 16.GB
        time   = 8.h
    }
    withLabel: assembly_large {
        cpus   = 12
        memory = 48.GB
        time   = 16.h
    }
}

profiles {

    docker {
        docker.enabled    = true
        docker.runOptions = '-u $(id -u):$(id -g)'
        singularity.enabled = false
    }

    singularity {
        singularity.enabled    = true
        singularity.autoMounts = true
        docker.enabled         = false
    }

    // Runs on the host with no containers. Only useful if every tool is
    // already installed and on PATH.
    local {
        docker.enabled      = false
        singularity.enabled = false
    }

    // Exercises the workflow wiring with stub blocks. No tools needed.
    // The label overrides must be repeated here: withLabel beats a bare
    // process.cpus, so setting only the latter still requests 8 cores.
    stub {
        docker.enabled      = false
        singularity.enabled = false
        process {
            cpus   = 1
            memory = 1.GB
            withLabel: light          { cpus = 1; memory = 1.GB }
            withLabel: assembly       { cpus = 1; memory = 1.GB }
            withLabel: assembly_large { cpus = 1; memory = 1.GB }
        }
    }

    slurm {
        process.executor      = 'slurm'
        // No default partition: an invented name like 'normal' is rejected by
        // any cluster that does not happen to have one. Unset means
        // Nextflow omits -p and SLURM picks the site default.
        process.queue         = System.getenv('HIVPIPE_QUEUE') ?: null
        singularity.enabled   = true
        singularity.autoMounts = true
        singularity.pullTimeout = '45m'
        docker.enabled        = false
    }

    // Small machine: keeps the assembly labels within laptop limits.
    lowmem {
        process {
            withLabel: assembly       { cpus = 2; memory = 6.GB  }
            withLabel: assembly_large { cpus = 2; memory = 8.GB  }
        }
    }
}

timeline { enabled = true; file = "${params.tracedir}/timeline.html"; overwrite = true }
report   { enabled = true; file = "${params.tracedir}/report.html";   overwrite = true }
trace    { enabled = true; file = "${params.tracedir}/trace.txt";     overwrite = true }
